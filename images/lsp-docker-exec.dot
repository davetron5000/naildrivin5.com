digraph G {
  
  rankdir="LR"
  node[fontname="Jost"]
  subgraph cluster_docker {
      label = "Docker Container"
      fontname="Jost"
      
      MountedDir
  }
  subgraph cluster_host {
      label = "Your Computer"
      fontname="Jost"
      
      SourceDir
  }
 
  MountedDir              [ shape=component class="shape purple" fontname="Monaspace Krypton Var" label="lsp-ruby # e.g."]
  SourceDir               [ shape=tab       class="shape amber"                     label="Neovim"]
  SourceDir -> MountedDir [ label="docker compose exec" fontname="Monaspace Krypton Var"]
 
}
