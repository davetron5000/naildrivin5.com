digraph G {

  node[fontname="Jost"]
  nodesep=0.5
  ranksep=0.5

  ExistingSystem -> Developer
  ChangeRequest  -> Developer
  BestPractices  -> Developer
  Developer      -> ProposedChange
  ProposedChange -> Review
  Review         -> Developer     [ label="  needs revision" fontname="Source Serif 4" fontsize=12]
  Review         -> UpdatedSystem [ label="   looks good"    fontname="Source Serif 4" fontsize=12]
  UpdatedSystem  -> SomeOutcome
  Note           -> SomeOutcome
  
  ExistingSystem [ shape=octagon       label="Any System"]
  ChangeRequest  [ shape=tab           label="Description of\lChange\l"]
  BestPractices  [ shape=cylinder      label="\lTools and Techniques\lfor Quality Software\lConstruction\l"]
  Developer      [ shape=egg class="shape indigo"]
  ProposedChange [ shape=folder        label="Proposed Change"]
  Review         [ shape=diamond class="shape amber"]
  UpdatedSystem  [ shape=doubleoctagon label="Updated System\nwith Change" class="shape teal"]
  SomeOutcome    [ shape=rect          label="Some Observable\nOutcome" class="shape green"]
  Note           [ shape=note          label="This is all that\lreally matters\l", fontname="Source Serif 4" fontsize=12 class="shape note"]

  { rank=same; SomeOutcome; Note }
}
