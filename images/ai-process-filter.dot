digraph G {

  node[fontname="Jost" class="shape"]
  nodesep=0.5
  ranksep=0.5
  rankdir=LR


  Selection -> Project1
  Selection -> Project2
  Selection -> FeatureA
  Selection -> FeatureB
  
  FeatureB  -> Scoping
  Scoping   -> Requirements1
  Scoping   -> Requirements2
  Scoping   -> Requirements3
  Scoping   -> Requirements4
  Requirements1 -> Delivery
  Requirements3 -> Delivery
  
  Selection [ shape=process ]
  Scoping   [ shape=process ]
  Delivery  [ shape=process ]
  Project1  [ label="Project\n(rejected)" shape="tab"    class="shape gray" fontsize=10]
  Project2  [ label="Project\n(rejected)" shape="tab"    class="shape gray" fontsize=10]
  FeatureA  [ label="Feature\n(rejected)" shape="folder" class="shape gray" fontsize=10]
  FeatureB  [ label="Feature" shape="folder" class="shape green"]

  Requirements1  [ label="Requirement" shape="note" class="shape green"]
  Requirements2  [ label="Requirement\n(rejected)" shape="note" class="shape gray" fontsize=10]
  Requirements3  [ label="Requirement" shape="note" class="shape green"]
  Requirements4  [ label="Requirement\n(rejected)" shape="note" class="shape gray" fontsize=10]

    
}
