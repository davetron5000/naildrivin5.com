digraph G {
  
  rankdir="LR"
  node[fontname="Jost"]
  subgraph cluster_docker {
      label = "Docker Container"
      fontname="Jost"
      
      MountedDir
  }
  subgraph cluster_host {
      label = "Your Computer"
      fontname="Jost"
      
      SourceDir
  }
 
  SourceDir -> MountedDir [dir=both label="Volume Mount" fontname="Source Serif 4"]
  MountedDir [shape=folder fontname="Monaspace Krypton Var" class="shape purple" label="/home/appuser/app"]
  SourceDir  [shape=folder fontname="Monaspace Krypton Var" class="shape amber" label="/home/davec/Projects/my-awesome-app"]
 
 
}
